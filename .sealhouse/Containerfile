# sealhouse build of dex on Red Hat Hardened Images (Hummingbird).
ARG BUILDER
ARG RUNTIME

FROM ${BUILDER} AS builder
WORKDIR /src
COPY go.mod go.sum ./
COPY api/v2/go.mod api/v2/go.sum api/v2/
RUN go mod download
COPY api/ api/
COPY cmd/ cmd/
COPY connector/ connector/
COPY pkg/ pkg/
COPY server/ server/
COPY storage/ storage/
COPY web/ web/
ARG LDFLAGS=""
# Without CGO the sqlite3 storage is left out.
RUN CGO_ENABLED=0 GOFIPS140=v1.26.0 go build -trimpath -ldflags "-buildid= ${LDFLAGS}" \
      -o /out/usr/local/bin/dex ./cmd/dex
COPY .sealhouse/config.yaml config.yaml
RUN install -D -m 0644 config.yaml /out/etc/dex/config.yaml

# The default config keeps everything in memory, so /tmp
# is the only writable path. Deployments mount their own config.
FROM ${RUNTIME}
COPY --from=builder /out/usr/local/bin/dex /usr/local/bin/dex
COPY --from=builder /out/etc/dex /etc/dex
ENTRYPOINT ["/usr/local/bin/dex"]
CMD ["serve", "/etc/dex/config.yaml"]
